# ------------------------------------------------------------------------------
# Julia
# ------------------------------------------------------------------------------
# Manifest: fija versiones exactas. Se ignora para que el entorno se resuelva
# desde Project.toml en cualquier máquina.
Manifest*.toml
JuliaManifest*.toml

# Preferencias locales generadas por Preferences.jl
LocalPreferences.toml
JuliaLocalPreferences.toml

# Cobertura de código (julia --code-coverage)
*.jl.cov
*.jl.*.cov

# Perfilado de asignaciones (julia --track-allocation)
*.jl.mem
*.mem

# Precompilación y depósito local de paquetes
.julia/
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Documentación generada por Documenter.jl
docs/build/
docs/site/

# ------------------------------------------------------------------------------
# Editores e IDEs
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#

# ------------------------------------------------------------------------------
# Sistema operativo
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ------------------------------------------------------------------------------
# Temporales y salidas locales
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
tmp/
scratch/

# Modelos serializados y figuras: se regeneran ejecutando el proyecto
*.bson
*.jld2
*.png
*.pdf
